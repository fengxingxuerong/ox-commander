{
  "name": "ox-commander",
  "private": true,
  "version": "0.1.0",
  "description": "总指挥智能体：把项目需求拆解后按 zone 并行下发给 SenseNova API 执行器（3 密钥 × 3 模型故障转移），经构建+测试多轮硬性验证后交付",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -b tsconfig.electron.json && cross-env OX_DEV_SERVER=1 electron .",
    "build": "tsc -b && vite build && tsc -b tsconfig.electron.json",
    "start": "electron .",
    "build:headless": "tsc -b tsconfig.headless.json",
    "smoke:artifact": "node scripts/artifact-smoke.mjs",
    "smoke:snapshot-secrets": "node scripts/e2e-snapshot-secrets.cjs",
    "smoke:gateway": "node scripts/admission-gateway-it.mjs",
    "smoke:coze": "node scripts/coze-bridge-it.mjs",
    "smoke:import": "node scripts/import-headless-run-it.mjs",
    "check:unwired": "node scripts/check-unwired.mjs",
    "check:scripts": "node scripts/check-syntax.mjs",
    "mutation": "node scripts/mutation-check.mjs --limit=8",
    "mutation:quick": "node scripts/mutation-check.mjs --tier=1 --limit=1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b && tsc -b tsconfig.electron.json && tsc -b tsconfig.headless.json",
    "verify": "npm run typecheck && npm run lint && npm run check:unwired && npm run check:scripts && npm test && npm run mutation:quick && npm run build && npm run build:headless && npm run smoke:artifact && npm run smoke:snapshot-secrets && npm run smoke:gateway && npm run smoke:coze && npm run smoke:import"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}

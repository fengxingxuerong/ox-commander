node_modules/
dist/
dist-cli/
dist-electron/
dist-headless/
release*/
logs/
*.log
.env
.env.local

# 覆盖率产物：每次 `npm run test:coverage` 都会重写，且体积不小。
# 实测漏掉这条时 `git add -A` 会把整个 coverage/ 收进去（2026-10-05 体检发现）。
coverage/

*.tsbuildinfo
scripts/.mutation-pending/

# Box-Agent 运行时目录（会话工作区与临时暂存）：属本机运行时状态，不是项目内容。
# 从未进过版本库，但 git add -A 会连它一起收 —— 显式忽略，避免误提交。
.box-agent/
.box-agent-scratch/

# 主机侧 artifact 标记（发布产物入口用，内容仅 {"type":"artifact"}）：运行时状态，非项目内容。
*.artifact.json

# WorkBuddy 会话目录（.workbuddy/memory/ 是本机会话记忆与日志）：属运行时状态，
# 不是项目内容。与 .box-agent/ 同性质 —— 显式忽略，避免 git add -A 误收。
.workbuddy/
